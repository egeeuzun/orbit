<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- История (orbit.db) и открытые вкладки (orbit_session.xml) никуда не
         уезжают: ни в облако, ни при переносе на новое устройство. -->
    <cloud-backup>
        <include domain="sharedpref" path="orbit.xml" />
        <exclude domain="sharedpref" path="orbit_session.xml" />
        <exclude domain="database" path="orbit.db" />
        <exclude domain="file" path="engine.bin" />
        <exclude domain="file" path="filters/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="orbit.xml" />
        <exclude domain="sharedpref" path="orbit_session.xml" />
        <exclude domain="database" path="orbit.db" />
    </device-transfer>
</data-extraction-rules>
