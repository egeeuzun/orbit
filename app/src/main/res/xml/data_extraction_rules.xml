<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="orbit.xml" />
        <include domain="database" path="orbit.db" />
        <exclude domain="file" path="engine.bin" />
        <exclude domain="file" path="filters/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="orbit.xml" />
        <include domain="database" path="orbit.db" />
    </device-transfer>
</data-extraction-rules>
