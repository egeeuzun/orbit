<?xml version="1.0" encoding="utf-8"?>
<!-- API<26 cihazlarda mipmap/ic_launcher.xml (adaptive-icon) drawable
     olarak çözülemiyor ve InflateException veriyor. AboutActivity ve pinned
     shortcut yedeği bu düz vektör-tabanlı logoya bağlanır. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
