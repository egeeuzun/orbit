<?xml version="1.0" encoding="utf-8"?>
<!-- Tablet sekme şeridinin tek sekmesi. Genişliği `TabStrip` sekme sayısına
     ve şerit genişliğine göre çalışma anında verir. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="200dp"
    android:layout_height="@dimen/tab_strip_item_height"
    android:layout_gravity="bottom"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/stripIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/stripTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        tools:text="Samsung Internet | Apps &amp; Services" />

    <ImageButton
        android:id="@+id/stripClose"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close_tab"
        android:padding="6dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_close"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
